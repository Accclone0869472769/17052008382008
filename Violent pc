    if mapFolder then
        for _, obj in ipairs(mapFolder:GetDescendants()) do
            local name = string.lower(obj.Name)
            if name == "generatorpoint1" or name == "generatorpoint2" then
                local target = obj.Parent
                if target and (target:IsA("Model") or target:IsA("Folder")) and not table.find(gens, target) then
                    table.insert(gens, target)
                end
            elseif name == "generator" and (obj:IsA("Model") or obj:IsA("Folder")) then
                if not table.find(gens, obj) then
                    table.insert(gens, obj)
                end
            end
            if name == "exit" or name == "gate" or name == "exitgate" then
                local target = (obj:IsA("Model") or obj:IsA("Folder")) and obj or obj.Parent
                if target and (target:IsA("Model") or target:IsA("Folder")) and not table.find(gates, target) then
                    table.insert(gates, target)
