local headboxNPCs = {}
local origHeadSizes = {}

local function cleanupHeadbox(npc)
    local data = headboxNPCs[npc]
    if not data then return end
    if data.connection then data.connection:Disconnect() end
    local head = data.head
    if head and head.Parent then
        head.Size = origHeadSizes[head] or Vector3.new(2, 1, 1)
        head.Transparency = 0
        head.CanCollide = true
        head.Massless = false
        if head:IsA("BasePart") then head.CastShadow = true end
        for _, child in ipairs(head:GetChildren()) do
            if child:IsA("Decal") or child:IsA("Texture") then
                child.Transparency = 0
            end
        end
    end
    origHeadSizes[head] = nil
    headboxNPCs[npc] = nil
end

local function applyHeadbox(npc)
    if headboxNPCs[npc] then return end
    if not npc or not npc.Parent then return end
    if Players:GetPlayerFromCharacter(npc) then return end
    local hum = npc:FindFirstChildOfClass("Humanoid")
    local head = npc:FindFirstChild("Head") or npc:FindFirstChild("HumanoidRootPart")
    if not hum or not head then return end
    if hum.Health <= 0 then return end
    origHeadSizes[head] = head.Size
    local throttle = 0
    local conn = RunService.Heartbeat:Connect(function(dt)
        if not npc.Parent or hum.Health <= 0 then cleanupHeadbox(npc) return end
        throttle = throttle + dt
        if throttle < 0.1 then return end
        throttle = 0
        local wanted = Vector3.new(100, 100, 100)
        if head.Size ~= wanted then
            head.Size = wanted
            head.Transparency = 1
            head.CanCollide = false
            head.Massless = true
            if head:IsA("BasePart") then head.CastShadow = false end
            for _, child in ipairs(head:GetChildren()) do
                if child:IsA("Decal") or child:IsA("Texture") then child.Transparency = 1 end
            end
        end
    end)
    headboxNPCs[npc] = { head = head, connection = conn }
end

