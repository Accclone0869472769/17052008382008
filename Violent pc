    end
    if tick() - lastAimScan >= AIM_SCAN_INTERVAL then
        lastAimScan = tick()
        if currentAimTarget and _isTargetValid(currentAimTarget) then
            local sp_cur = Camera:WorldToViewportPoint(currentAimTarget.Position)
            local cx = Camera.ViewportSize.X / 2 + AimSettings.FOVOffsetX
            local cy = Camera.ViewportSize.Y / 2 + AimSettings.FOVOffsetY
            local curDist = (Vector2.new(sp_cur.X, sp_cur.Y) - Vector2.new(cx, cy)).Magnitude
            local newTarget, newDist = _getClosest(), math.huge
            if newTarget then
                local sp_new = Camera:WorldToViewportPoint(newTarget.Position)
                newDist = (Vector2.new(sp_new.X, sp_new.Y) - Vector2.new(cx, cy)).Magnitude
            end
            if newTarget and newTarget ~= currentAimTarget and (curDist - newDist) >= SWITCH_THRESHOLD then
                currentAimTarget = newTarget
            end
        else
            currentAimTarget = _getClosest()
        end
    end
    _aimAt(currentAimTarget)
end)

local function floatTextSize(size)
    return math.clamp(math.floor(size * 0.28 + 0.5), 9, 14)
end

local function makeDraggableFloat(b, posKey)
    local dragging, moved, startPos, startBtnPos, activeInput = false, false, nil, nil, nil
    b.InputBegan:Connect(function(input)
        if S.floatLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, moved, startPos, startBtnPos, activeInput = true, false, input.Position, b.Position, input
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    activeInput = nil
                    if moved and posKey then
                        local p = b.Position
                        Config[posKey] = { xs = p.X.Scale, xo = p.X.Offset, ys = p.Y.Scale, yo = p.Y.Offset }
                        SaveConfig()
                    end
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - startPos
            if delta.Magnitude > 6 then moved = true end
            b.Position = UDim2.new(startBtnPos.X.Scale, startBtnPos.X.Offset + delta.X, startBtnPos.Y.Scale, startBtnPos.Y.Offset + delta.Y)
        end
    end)
    return function() return moved end, function() moved = false end
end

