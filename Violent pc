local function getPrimaryPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") and obj.PrimaryPart then return obj.PrimaryPart end
    if obj:IsA("Tool") and obj:FindFirstChild("Handle") then return obj.Handle end
    local pt = obj:FindFirstChild("GeneratorPoint1") or obj:FindFirstChild("GeneratorPoint2") or obj:FindFirstChild("Hitbox") or obj:FindFirstChild("HookPoint")
    if pt and pt:IsA("BasePart") then return pt end
    for _, child in ipairs(obj:GetDescendants()) do
        if child:IsA("BasePart") and child.Transparency < 1 then return child end
    end
    for _, child in ipairs(obj:GetDescendants()) do
        if child:IsA("BasePart") then return child end
    end
    return nil
end

