local function updateWorldESP()
    local foundGens = {}
    local foundGates = {}
    local foundHooks = {}
    local mapFolder = workspace:FindFirstChild("Map")
    if mapFolder then
        for _, obj in ipairs(mapFolder:GetDescendants()) do
            local name = string.lower(obj.Name)
            if name == "generatorpoint1" or name == "generatorpoint2" then
                local target = obj.Parent
                if target and (target:IsA("Model") or target:IsA("Folder")) then
                    foundGens[target] = true
                    if S.genESPEnabled and not S.genESPObjects[target] then
                        createGenESP(target)
                    end
                end
            elseif name == "generator" and (obj:IsA("Model") or obj:IsA("Folder")) then
                foundGens[obj] = true
                if S.genESPEnabled and not S.genESPObjects[obj] then
                    createGenESP(obj)
                end
            end
            if name == "exit" or name == "gate" or name == "exitgate" then
                local target = (obj:IsA("Model") or obj:IsA("Folder")) and obj or obj.Parent
                if target and (target:IsA("Model") or target:IsA("Folder")) then
                    foundGates[target] = true
                    if S.gateESPEnabled and not S.gateESPObjects[target] then
                        createGateESP(target)
                    end
                end
            end
            if name == "hookpoint" then
                local target = obj.Parent
                if target and target:IsA("Model") then
                    foundHooks[target] = true
                    if S.hookESPEnabled and not S.hookESPObjects[target] then
                        createHookESP(target)
                    end
                end
            elseif string.find(name, "hook") and obj:IsA("Model") then
                foundHooks[obj] = true
                if S.hookESPEnabled and not S.hookESPObjects[obj] then
                    createHookESP(obj)
                end
            end
        end
    end
    for gen, _ in pairs(S.genESPObjects) do
        if not S.genESPEnabled or not foundGens[gen] or not gen.Parent then removeGenESP(gen) end
    end
    for gate, _ in pairs(S.gateESPObjects) do
        if not S.gateESPEnabled or not foundGates[gate] or not gate.Parent then removeGateESP(gate) end
    end
    for hook, _ in pairs(S.hookESPObjects) do
        if not S.hookESPEnabled or not foundHooks[hook] or not hook.Parent then removeHookESP(hook) end
    end
end

