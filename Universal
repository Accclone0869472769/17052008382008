local INVISIBILITY_POSITION = Vector3.new(-25.95, 84, 3537.55)

local function getHumanoidRootPart()
    local character = LocalPlayer.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function setCharacterTransparency(character, transparency)
    if not character then return end
    for _, d in character:GetDescendants() do
        if d:FindFirstAncestorOfClass("Accessory") then continue end
        if d:IsA("BasePart") then
            if d.Name == "HumanoidRootPart" then
                d.Transparency = 1
            elseif d.Name == "Head" then
                d.Transparency = 0
            else
                d.Transparency = transparency
            end
        elseif d:IsA("Decal") then
            if d.Name == "face" and d.Parent and d.Parent.Name == "Head" then
                d.Transparency = 0
            else
                d.Transparency = transparency
            end
        end
    end
end

local function toggleInvisibility()
    if not LocalPlayer.Character then return end
    S.isInvisible = not S.isInvisible
    local cam = workspace.CurrentCamera
    if S.isInvisible then
        local hrp = getHumanoidRootPart()
        if not hrp then return end
        local savedCFrame = hrp.CFrame
        local savedCamCFrame = cam.CFrame
        cam.CameraType = Enum.CameraType.Scriptable
        cam.CFrame = savedCamCFrame
        LocalPlayer.Character:MoveTo(INVISIBILITY_POSITION)
        task.wait(0.1)
        local seat = Instance.new("Seat")
        seat.Name = "invischair"
        seat.Anchored = false
        seat.CanCollide = false
        seat.Transparency = 1
        seat.Size = Vector3.new(2, 0.5, 2)
        seat.Position = INVISIBILITY_POSITION
        seat.Parent = workspace
        local weld = Instance.new("Weld")
        weld.Part0 = seat
        weld.Part1 = hrp
        weld.Parent = seat
        task.wait()
        task.defer(function()
            if seat and seat.Parent then seat.CFrame = savedCFrame end
        end)
        cam.CameraType = Enum.CameraType.Custom
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then cam.CameraSubject = humanoid end
        setCharacterTransparency(LocalPlayer.Character, 0.5)
        hrp.Transparency = 1
    else
        local chair = workspace:FindFirstChild("invischair")
        if chair then chair:Destroy() end
        if LocalPlayer.Character then
            setCharacterTransparency(LocalPlayer.Character, 0)
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Transparency = 1 end
            local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then cam.CameraSubject = humanoid end
        end
    end
end

local function isAlive(character)
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

local function removeOutlineChams(character)
    if not character then return end
    for _, part in ipairs({ character:FindFirstChild("Head"), character:FindFirstChild("HumanoidRootPart") }) do
        if part then
            for _, c in ipairs(part:GetChildren()) do
                if c:IsA("SelectionBox") and c.Name == "StarCrowOutline" then
                    c:Destroy()
                end
            end
        end
    end
end

local function addOutlineChams(character, part, size)
    if not character or not isAlive(character) then return end
    if not part or not part:IsA("BasePart") then return end
    for _, c in ipairs(part:GetChildren()) do
        if c:IsA("SelectionBox") and c.Name == "StarCrowOutline" then
            c:Destroy()
        end
    end
    local box = Instance.new("SelectionBox")
    box.Name = "StarCrowOutline"
    box.Adornee = part
    box.Color3 = Color3.fromRGB(255, 80, 80)
    box.LineThickness = 0.04
    box.SurfaceTransparency = 1
    box.SurfaceColor3 = Color3.fromRGB(255, 80, 80)
    box.Parent = part
end

local function removeHeadHitbox(character)
    if not character then return end
    S.processedChars[character] = nil
    removeOutlineChams(character)
    local head = character:FindFirstChild("Head")
    if not head then return end
    local origSize = head:FindFirstChild("OriginalSize")
    if origSize then
        head.Size = origSize.Value
        origSize:Destroy()
    end
    local origColor = head:FindFirstChild("OriginalColor")
    if origColor then
        head.Color = origColor.Value
        origColor:Destroy()
    end
    local meshBackup = head:FindFirstChild("__MeshBackup")
    if meshBackup then
        local realMesh = meshBackup:FindFirstChildOfClass("SpecialMesh") or meshBackup:FindFirstChildOfClass("BlockMesh")
        if realMesh then
            realMesh:Clone().Parent = head
        end
        meshBackup:Destroy()
    end
    head.Transparency = 0
    head.CanCollide = false
    head.Material = Enum.Material.Plastic
    head.Massless = false
end

local function applyHeadHitbox(player, character, size)
    if not player or not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        if S.processedChars[character] then removeHeadHitbox(character) end
        return
    end
    local head = character:FindFirstChild("Head")
    if not head then return end
    local teamColor = Color3.fromRGB(255, 255, 255)
    local targetSize = Vector3.new(size, size, size)
    if humanoid.Health <= 0 then
        if S.processedChars[character] then removeHeadHitbox(character) end
        return
    end
    if not head:FindFirstChild("OriginalSize") then
        local sv = Instance.new("Vector3Value")
        sv.Name = "OriginalSize"
        sv.Value = head.Size
        sv.Parent = head
    end
    if not head:FindFirstChild("OriginalColor") then
        local cv = Instance.new("Color3Value")
        cv.Name = "OriginalColor"
        cv.Value = head.Color
        cv.Parent = head
    end
    local meshBackup = head:FindFirstChild("__MeshBackup")
    if not meshBackup then
        local existingMesh = head:FindFirstChildOfClass("SpecialMesh") or head:FindFirstChildOfClass("BlockMesh")
        if existingMesh then
            local folder = Instance.new("Folder")
            folder.Name = "__MeshBackup"
            folder.Parent = head
            existingMesh:Clone().Parent = folder
            existingMesh:Destroy()
        end
    else
        local strayMesh = head:FindFirstChildOfClass("SpecialMesh") or head:FindFirstChildOfClass("BlockMesh")
        if strayMesh then strayMesh:Destroy() end
    end
    if humanoid.Health <= 0 then
        removeHeadHitbox(character)
        return
    end
    local needsRefresh = head.Size ~= targetSize or head.Transparency < 0.45 or head.Transparency > 0.55 or head.Material ~= Enum.Material.ForceField or head.CanCollide ~= false or head.Massless ~= true or head.Color ~= teamColor
    if needsRefresh then
        head.Massless = true
        head.Size = targetSize
        head.CanCollide = false
        head.Transparency = 0.5
        head.Material = Enum.Material.ForceField
        head.Color = teamColor
    end
    if not character:FindFirstChild("__HeadHitboxDeathHook") then
        local tag = Instance.new("BoolValue")
        tag.Name = "__HeadHitboxDeathHook"
        tag.Parent = character
        humanoid.Died:Connect(function()
            if character and character.Parent then removeHeadHitbox(character) end
        end)
        humanoid:GetPropertyChangedSignal("Health"):Connect(function()
            if humanoid.Health <= 0 then
                if character and character.Parent then removeHeadHitbox(character) end
            end
        end)
        task.spawn(function()
            while true do
                task.wait(0.5)
                if not character or not character.Parent then
                    task.wait(2)
                    if not character or not character.Parent then break end
                end
                if not S.autoHitboxEnabled then break end
                if not S.processedChars[character] then break end
                local currentHumanoid = character:FindFirstChildOfClass("Humanoid")
                if not currentHumanoid or currentHumanoid.Health <= 0 then break end
                local h = character:FindFirstChild("Head")
                if h and not h:FindFirstChild("StarCrowOutline") then
                    addOutlineChams(character, h)
                end
            end
        end)
    end
    local h = character:FindFirstChild("Head")
    if h and not h:FindFirstChild("StarCrowOutline") then
        addOutlineChams(character, h)
    end
    S.processedChars[character] = true
end

local function applyBodyHitbox(character, size)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    pcall(function()
        hrp.Size = Vector3.new(size, size, size)
        hrp.CanCollide = false
        hrp.Transparency = 0.5
        hrp.Material = Enum.Material.ForceField
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part ~= hrp then
                part.CanCollide = false
            end
        end
    end)
    S.bodyHitboxChars[character] = true
    addOutlineChams(character, hrp)
end

local function resetBodyHitbox(character)
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    pcall(function()
        hrp.Size = Vector3.new(2, 2, 1)
        hrp.Transparency = 1
        hrp.CanCollide = false
        hrp.Material = Enum.Material.Plastic
    end)
    S.bodyHitboxChars[character] = nil
    removeOutlineChams(character)
end

local function getTeamColor(player)
    if player.Team and player.Team.TeamColor then
        return player.Team.TeamColor.Color
    end
    return Color3.fromRGB(255, 255, 255)
end

local function removeNameESP(player)
    if S.nameESPObjects[player] then
        pcall(function() S.nameESPObjects[player]:Destroy() end)
        S.nameESPObjects[player] = nil
    end
    pcall(function()
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Automatic
                hum.HealthDisplayType   = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
            end
        end
    end)
end

local function createNameESP(player, char)
    if player == LocalPlayer then return end
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    removeNameESP(player)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "NameESP"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 240, 0, 22)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = math.huge
    billboard.Parent = head
    pcall(function()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            hum.HealthDisplayType   = Enum.HumanoidHealthDisplayType.AlwaysOff
        end
    end)
    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(1, 0, 1, 0)
    infoLabel.Position = UDim2.new(0, 0, 0, 0)
    infoLabel.BackgroundTransparency = 1
    infoLabel.RichText = true
    infoLabel.Text = player.Name
    infoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    infoLabel.TextStrokeTransparency = 0
    infoLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    infoLabel.Font = Enum.Font.GothamBold
    infoLabel.TextSize = 13
    infoLabel.TextXAlignment = Enum.TextXAlignment.Center
    infoLabel.Parent = billboard
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not billboard or not billboard.Parent then
            conn:Disconnect() return
        end
        if not isAlive(char) then
            billboard.Enabled = false return
        end
        billboard.Enabled = true
        local nc = getTeamColor(player)
        local nameHex = string.format("#%02x%02x%02x",
            math.clamp(math.floor(nc.R * 255), 0, 255),
            math.clamp(math.floor(nc.G * 255), 0, 255),
            math.clamp(math.floor(nc.B * 255), 0, 255)
        )
        local parts = {}
        if S.espNameOnly then
            parts[#parts + 1] = string.format('<font color="%s">%s</font>', nameHex, player.Name)
        end
        if S.espDistOnly and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") and head and head.Parent then
            local dist = math.floor((head.Position - LocalPlayer.Character.Head.Position).Magnitude)
            parts[#parts + 1] = dist .. "m"
        end
        if S.espHpOnly then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local hpPercent = 100
            local hpColor = "#00ff00"
            if humanoid then
                hpPercent = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
                hpColor = hpPercent > 60 and "#00ff00" or hpPercent > 30 and "#ffaa00" or "#ff3300"
            end
            parts[#parts + 1] = string.format('<font color="%s">%d%%</font>', hpColor, hpPercent)
        end
        infoLabel.Text = table.concat(parts, " | ")
    end)
    S.nameESPObjects[player] = billboard
end

local function removeChams(character)
    if not character then return end
    local highlight = character:FindFirstChild("StarCrowChams")
    if highlight then highlight:Destroy() end
end

local function addChams(character, color)
    if not character or not isAlive(character) then return end
    removeChams(character)
    local chamColor = color or Color3.fromRGB(50, 200, 120)
    local highlight = Instance.new("Highlight")
    highlight.Name = "StarCrowChams"
    highlight.Adornee = character
    highlight.FillColor = chamColor
    highlight.FillTransparency = 0.3
    highlight.OutlineColor = chamColor
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
end

local function removeTracerESP(player)
    if S.tracerESPObjects[player] then
        pcall(function() S.tracerESPObjects[player].Line:Remove() end)
        pcall(function() S.tracerESPObjects[player].Connection:Disconnect() end)
        S.tracerESPObjects[player] = nil
    end
end

local function createTracerESP(player)
    if player == LocalPlayer then return end
    removeTracerESP(player)
    local line = Drawing.new("Line")
    line.Visible = false
    line.Thickness = 1.8
    line.Transparency = 1
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not S.tracerESPEnabled then
            line.Visible = false
            return
        end
