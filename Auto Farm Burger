local bossHitboxNPCs = {}
local bossOrigSizes  = {}

local bossTargets = {
    mastersamurai  = true,
    eldervampire   = true,
    gnomechampion  = true,
    steamborneczar = true,
    kingice        = true,
}

local function isBossModel(model)
    local name = string.gsub(string.lower(model.Name), "%s+", "")
    for n in pairs(bossTargets) do
        if string.find(name, n) then return true end
    end
    return false
end

local function cleanupBossHitbox(npc)
    local data = bossHitboxNPCs[npc]
    if not data then return end
    if data.connection then data.connection:Disconnect() end
    local hrp = data.hrp
    if hrp and hrp.Parent then
        hrp.Size          = bossOrigSizes[hrp] or Vector3.new(2, 2, 1)
        hrp.Transparency  = 1
        hrp.CanCollide    = true
        hrp.Massless      = false
    end
    bossOrigSizes[hrp]   = nil
    bossHitboxNPCs[npc]  = nil
end

local function applyBossHitbox(npc)
    if bossHitboxNPCs[npc] then return end
    if not npc or not npc.Parent then return end
    if not isBossModel(npc) then return end
    local hum = npc:FindFirstChildOfClass("Humanoid")
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    if hum.Health <= 0 then return end
    bossOrigSizes[hrp] = hrp.Size
    local throttle = 0
    local conn = RunService.Heartbeat:Connect(function(dt)
        if not npc.Parent or hum.Health <= 0 then
            cleanupBossHitbox(npc)
            return
        end
        throttle = throttle + dt
        if throttle < 0.1 then return end
        throttle = 0
        local wanted = Vector3.new(200, 200, 200)
        if hrp.Size ~= wanted then
            hrp.Size          = wanted
            hrp.Transparency  = 1
            hrp.CanCollide    = false
            hrp.Massless      = true
        end
    end)
    bossHitboxNPCs[npc] = { hrp = hrp, connection = conn }
end

