local function updateBurgerESP()
    for i = #activeBurgers, 1, -1 do
        local obj = activeBurgers[i]
        if not obj or not obj.Parent then
            table.remove(activeBurgers, i)
        else
            local espFolder = obj:FindFirstChild("StarCrowBurgerESP")
            if not espFolder then buildBurgerESP(obj) espFolder = obj:FindFirstChild("StarCrowBurgerESP") end
            if espFolder then
                local hl = espFolder:FindFirstChild("Chams")
                if hl then hl.Enabled = Config.BurgerESPEnabled end
                local bb = espFolder:FindFirstChild("Text")
                if bb then
                    bb.Enabled = Config.BurgerESPEnabled
                    if Config.BurgerESPEnabled then
                        local lbl  = bb:FindFirstChildWhichIsA("TextLabel")
                        local part = bb.Adornee
                        if lbl and part and Camera then
                            local dist = math.floor((Camera.CFrame.Position - part.Position).Magnitude)
                            lbl.Text = string.format("%s\n[%dm]", obj.Name, dist)
                        end
                    end
                end
            end
        end
    end
end

