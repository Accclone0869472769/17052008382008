    if now - lastToggleTime < 0.3 then return end
    lastToggleTime = now
    VirtualInputManager:SendKeyEvent(true, minimizeKey, false, game)
    task.wait()
    VirtualInputManager:SendKeyEvent(false, minimizeKey, false, game)
end

