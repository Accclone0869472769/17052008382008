local function awTp(cframePos)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = cframePos
        hrp.Velocity = Vector3.zero
    end
end

local function awInteractPrompt(keyword)
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local obj = prompt.ObjectText or ""
            local act = prompt.ActionText or ""
            if string.find(obj, keyword) or string.find(act, keyword) then
                local p = prompt.Parent
                if p and p:IsA("BasePart") then
                    awTp(p.CFrame)
                    task.wait(0.3)
                end
                local old = prompt.HoldDuration
                prompt.HoldDuration = 0
                if fireproximityprompt then fireproximityprompt(prompt) end
                task.wait(0.1)
                prompt.HoldDuration = old
                return true
            end
        end
    end
    return false
end

local function awWaitPrompt(keyword, timeout)
    local t = tick()
    while tick() - t < timeout do
        if awInteractPrompt(keyword) then return true end
        task.wait(0.5)
    end
    return false
end

local function farmEarlyMob(targetName, timeout)
    local t = tick()
    while tick() - t < timeout do
        if not autoWinRunning then break end
        local target = nil
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Model") and string.find(v.Name, targetName) and isValidNPC(v) then
                target = v break
            end
        end
        if not target then break end
        local char = LocalPlayer.Character
        if char then
            local myHrp = char:FindFirstChild("HumanoidRootPart")
            local tHrp = target:FindFirstChild("HumanoidRootPart")
            if myHrp and tHrp then
                tHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -4)
                tHrp.Velocity = Vector3.zero
            end
        end
        task.wait(0.1)
    end
end

local function killBossAtPos(bossName, spawnPos)
    local boss = nil
    while not boss and autoWinRunning do
        awTp(spawnPos)
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Model") and string.find(v.Name, bossName) and isValidNPC(v) then
                boss = v break
            end
        end
        task.wait(0.5)
    end
    local hum = boss and boss:FindFirstChildOfClass("Humanoid")
    while autoWinRunning and boss and boss.Parent and hum and hum.Health > 0 do
        local char = LocalPlayer.Character
        if char then
            local myHrp = char:FindFirstChild("HumanoidRootPart")
            local tHrp = boss:FindFirstChild("HumanoidRootPart")
            if myHrp and tHrp then
                tHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -5)
                tHrp.Velocity = Vector3.zero
            end
        end
        task.wait(0.1)
    end
end

local function killFinalStage(spawnPos)
    local targets = {"CommanderViridian", "CommanderCrimson", "CommanderCerulean", "VoidReaper"}
    local engaged = false
    while autoWinRunning and task.wait(0.1) do
        local char = LocalPlayer.Character
        if not char then continue end
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then continue end
        local aliveCount = 0
        local foundAny = false
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Model") and isValidNPC(v) then
                for _, n in ipairs(targets) do
                    if string.find(v.Name, n) then
                        foundAny = true
                        aliveCount = aliveCount + 1
                        local tHrp = v:FindFirstChild("HumanoidRootPart")
                        if tHrp then
                            tHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -5)
                            tHrp.Velocity = Vector3.zero
                        end
                        break
                    end
                end
            end
        end
        if foundAny then engaged = true
        elseif engaged and aliveCount == 0 then break
        elseif not engaged then awTp(spawnPos)
        end
    end
end

local function startMeteorDodge()
    if meteorThread then return end
    meteorThread = task.spawn(function()
        while autoWinRunning do
            task.wait(0.05)
            local char = LocalPlayer.Character
            if not char then continue end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end
            local myPos = hrp.Position
            local closestDir, closestDist = nil, math.huge
            for _, v in ipairs(workspace:GetDescendants()) do
                if v.Name == "KillPart" and v:IsA("BasePart") then
                    local dist = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(v.Position.X, 0, v.Position.Z)).Magnitude
                    if dist < 20 and dist < closestDist then
                        closestDist = dist
                        local dir = Vector3.new(myPos.X - v.Position.X, 0, myPos.Z - v.Position.Z)
                        closestDir = dir.Magnitude > 0 and dir.Unit or Vector3.new(1, 0, 0)
                    end
                end
            end
            if closestDir then
                hrp.CFrame = hrp.CFrame + closestDir * 8
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
        end
        meteorThread = nil
    end)
end

local function stopMeteorDodge()
    if meteorThread then task.cancel(meteorThread) meteorThread = nil end
end

local function startAutoAttack()
