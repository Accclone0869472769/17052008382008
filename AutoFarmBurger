    { n = "mastersamurai",  pos = CFrame.new(103.27,  40.89,  -3560.05) },
    { n = "eldervampire",   pos = CFrame.new(165.61,   3.00,   5058.65) },
    { n = "gnomechampion",  pos = CFrame.new(37.76,    3.00,  13993.09) },
    { n = "steamborneczar", pos = CFrame.new(-15.31,   3.02,  27032.90) },
    { n = "kingice",        pos = CFrame.new(24.27,    3.00,  45907.91) },
}

local skyIslandPos     = CFrame.new(64.97, 3.00, 34971.64)
local currentIdx       = 1
local hoverPos         = nil
local visited          = false
local engaged          = false
local visitedSkyIsland = false

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char or not hoverPos or not Config.AutoFarmEnabled then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame   = hoverPos
        hrp.Velocity = Vector3.new(0, 0, 0)
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if not Config.AutoFarmEnabled then hoverPos = nil continue end
        local char = LocalPlayer.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not hrp or not hum then continue end

        if autoFarmStartTime > 0 and tick() - autoFarmStartTime >= Config.AutoResetMinutes * 60 then
            pcall(function()
                local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
                for _ = 1, 3 do Remotes.Reset.fireServer() task.wait(1) end
            end)
            hoverPos = nil visited = false engaged = false visitedSkyIsland = false
            currentIdx = 1 autoFarmStartTime = tick()
            continue
        end

        if hum.Health <= 0 then
            hoverPos = nil visited = false engaged = false visitedSkyIsland = false
            currentIdx = 1 task.wait(1) continue
        end

        if currentIdx <= #bosses then
            local info       = bosses[currentIdx]
            local targetBoss = cachedBosses[info.n]
            if targetBoss then
                local bHrp = targetBoss:FindFirstChild("HumanoidRootPart")
                local bHum = targetBoss:FindFirstChildOfClass("Humanoid")
                if bHrp and bHum and bHum.Health > 0 then
                    if not visited then
                        hoverPos = nil hrp.CFrame = info.pos hrp.Anchored = true
                        task.wait(2) hrp.Anchored = false visited = true
                    end
                    engaged = true
                    bHrp.CFrame = CFrame.new(info.pos.Position)
                    bHrp.Velocity = Vector3.new(0, 0, 0)
                    hoverPos = CFrame.lookAt(info.pos.Position + Vector3.new(0, 15, 0), info.pos.Position)
                    local tool = char:FindFirstChildOfClass("Tool")
                    if not tool or not isMelee(tool) then
                        for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do
                            if t:IsA("Tool") and isMelee(t) then t.Parent = char break end
                        end
                    end
                elseif bHum and bHum.Health <= 0 then
                    task.wait(3) engaged = false visited = false hoverPos = nil currentIdx = currentIdx + 1
                end
            else
                if engaged then
                    task.wait(3) engaged = false visited = false hoverPos = nil currentIdx = currentIdx + 1
                else
                    if not visited then
                        hoverPos = nil hrp.CFrame = info.pos hrp.Anchored = true
                        task.wait(2) hrp.Anchored = false visited = true
                    end
                    hoverPos = CFrame.new(info.pos.Position + Vector3.new(0, 15, 0))
                end
            end
        else
            if not visitedSkyIsland then
                hoverPos = nil hrp.CFrame = skyIslandPos hrp.Anchored = true
                task.wait(2) hrp.Anchored = false visitedSkyIsland = true hoverPos = skyIslandPos
            end
            if #itemQueue == 0 and currentTarget == nil then
                task.wait(3)
                if #itemQueue == 0 and currentTarget == nil then
                    hoverPos = nil visitedSkyIsland = false currentIdx = 1 autoFarmStartTime = tick()
                    task.spawn(function()
                        pcall(function()
                            local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
                            Remotes.Reset.fireServer()
                        end)
                    end)
                end
            end
        end
    end
end)

