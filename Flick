local autoSpawnFastActive = false
local function loopAutoSpawnFast()
    if autoSpawnFastActive then return end
    autoSpawnFastActive = true
    task.spawn(function()
        while Config.AutoSpawnFastEnabled do
            local char = LocalPlayer.Character
            local isDead = false

            if not char then
                isDead = true
            else
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then
                    isDead = true
                end
            end

            if isDead then
                pcall(function()
                    ReplicatedStorage:WaitForChild("Remotes", 1):WaitForChild("Command", 1):FireServer("Play")
                end)
            end

            task.wait(0.1)
        end
        autoSpawnFastActive = false
    end)
end

