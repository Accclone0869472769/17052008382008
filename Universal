end

local function startFloat()
    floatCleanup()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    S.floatTargetY = hrp.Position.Y - 3.2
    S.floatPlatform = Instance.new("Part")
    S.floatPlatform.Size = Vector3.new(15, 0.5, 15)
    S.floatPlatform.Anchored = true
    S.floatPlatform.CanCollide = true
    S.floatPlatform.Transparency = 1
    S.floatPlatform.Parent = workspace
    S.floatLoop = RunService.Heartbeat:Connect(function()
        local c = LocalPlayer.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if root and S.floatPlatform and not S.isJumping then
            S.floatPlatform.CFrame = CFrame.new(root.Position.X, S.floatTargetY, root.Position.Z)
        end
    end)
    S.floatJumpConn = UserInputService.JumpRequest:Connect(function()
        if not S.floatEnabled or S.isJumping then return end
        local c = LocalPlayer.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        S.isJumping = true
        if S.floatPlatform then S.floatPlatform.CanCollide = false end
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        task.wait(0.1)
        while root and root.Velocity.Y > 0 and S.floatEnabled do
            task.wait()
        end
        if root and hum and S.floatPlatform then
            S.floatTargetY = root.Position.Y - 3.2
            S.floatPlatform.CFrame = CFrame.new(root.Position.X, S.floatTargetY, root.Position.Z)
            S.floatPlatform.CanCollide = true
            hum:ChangeState(Enum.HumanoidStateType.Landed)
        end
        S.isJumping = false
    end)
end

local function stopFloat()
    floatCleanup()
end

