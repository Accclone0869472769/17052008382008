local function runAutoWin()
    local mainPos = CFrame.new(18.15, 45.24, 47112.82)
    awTp(mainPos)
    task.wait(1)

    local waitStart = tick()

    awWaitPrompt("Break", 30)
    task.wait(1)
    awWaitPrompt("Activate", 30)
    task.wait(1)

    awTp(mainPos)
    task.wait(1)

    pcall(function()
        game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents", 9e9):WaitForChild("Portal", 9e9):WaitForChild("RemoteEvent", 9e9):FireServer("FadeAckVoid")
    end)

    while tick() - waitStart < 190 do
        if not autoWinRunning then return end
        task.wait(1)
    end

    for _, data in ipairs({
        { name = "CommanderViridian", pos = CFrame.new(-0.14, 26.23, -59313.88) },
        { name = "CommanderCerulean", pos = CFrame.new(12.03, 19.77, -57702.19) },
        { name = "CommanderCrimson",  pos = CFrame.new(-21.34, 41.58, -55743.54) }
    }) do
        if not autoWinRunning then return end
        killBossAtPos(data.name, data.pos)
        task.wait(3)
    end

    if not autoWinRunning then return end
    killFinalStage(CFrame.new(-18.10, 2.09, -53101.93))
    
    stopAutoAttack()
    stopMeteorDodge()
    
    local finalPos = CFrame.new(10.49, 1074.70, -52705.92)
    local angle = 0
    local dir = 1
    
    while autoWinRunning do
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                angle = angle + (15 * dir)
                if angle >= 90 then 
                    dir = -1 
                elseif angle <= -90 then 
                    dir = 1 
                end
                hrp.CFrame = finalPos * CFrame.Angles(0, math.rad(angle), 0)
            end
        end
        task.wait(0.05)
    end
end

