local function applyPalletESP(obj)
    if not obj:FindFirstChild("PalletChams") then
        local chams = Instance.new("Highlight")
        chams.Name = "PalletChams"
        chams.Adornee = obj
        chams.FillColor = Color3.fromRGB(255, 0, 0)
        chams.FillTransparency = 0.5
        chams.OutlineColor = Color3.fromRGB(255, 255, 255)
        chams.OutlineTransparency = 0
        chams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        chams.Parent = obj
    end
end

local function removePalletESP(obj)
    local chams = obj:FindFirstChild("PalletChams")
    if chams then chams:Destroy() end
end

local function isValidPallet(obj)
    if not string.find(obj.Name, "Pallet") then return false end
    local isInteractable = obj:FindFirstChildWhichIsA("ProximityPrompt", true) or obj:FindFirstChildWhichIsA("ClickDetector", true)
    if isInteractable or (obj:IsA("Model") and #obj:GetChildren() > 1) then return true end
    return false
end

