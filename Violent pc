local function createParryCircle()
    if circleFolder and circleFolder.Parent then return end
    if circleFolder then circleFolder:Destroy() end
    circleParts = {}
    local folder = Instance.new("Folder")
    folder.Name = "ParryCircle"
    folder.Parent = workspace
    circleFolder = folder
    local numSeg = 48
    local angleStep = (2 * math.pi) / numSeg
    for i = 1, numSeg do
        local seg = Instance.new("Part")
        seg.Anchored = true
        seg.CanCollide = false
        seg.CanTouch = false
        seg.CanQuery = false
        seg.CastShadow = false
        seg.Material = Enum.Material.Neon
        seg.Color = Color3.fromRGB(0, 255, 255)
        seg.Transparency = 0.15
        seg.Parent = folder
        table.insert(circleParts, {part = seg, index = i, angleStep = angleStep})
    end
end

local function updateCircle(rootPos)
    local numSeg = 48
    local segLen = (2 * math.pi * S.parryRange / numSeg) + 0.1
    for _, data in ipairs(circleParts) do
        data.part.Size = Vector3.new(0.12, 0.12, segLen)
        local angle = (data.index - 0.5) * data.angleStep
        local nextAngle = data.index * data.angleStep
        local x = math.cos(angle) * S.parryRange
        local z = math.sin(angle) * S.parryRange
        local nx = math.cos(nextAngle) * S.parryRange
        local nz = math.sin(nextAngle) * S.parryRange
        local base = rootPos + Vector3.new(0, -2.8, 0)
        data.part.CFrame = CFrame.new(
            base + Vector3.new((x+nx)/2, 0, (z+nz)/2),
            base + Vector3.new(nx, 0, nz)
        )
    end
end

local function setCircleVisible(v)
    for _, data in ipairs(circleParts) do
        data.part.Transparency = v and 0.15 or 1
    end
end

