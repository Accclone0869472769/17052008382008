local npcs = {}
local origSizes = {}

local function isValidNPC(model)
    if not model or not model.Parent or not model:IsA("Model") then return false end
    if model == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(model) then return false end

    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")

    if not hum or not root then return false end
    if hum.Health <= 0 or hum.MaxHealth <= 0 then return false end
    if root.Anchored then return false end

    return true
end

local function cleanupNPC(npc)
    local data = npcs[npc]
    if not data then return end
    if data.connection then data.connection:Disconnect() end
    local hrp = data.hrp
    if hrp and hrp.Parent then
        hrp.Size = origSizes[hrp] or Vector3.new(2, 2, 1)
        hrp.Transparency = 1
        hrp.CanCollide = true
        hrp.Massless = false
    end
    origSizes[hrp] = nil
    npcs[npc] = nil
end

local function applyHitbox(npc)
    if not isValidNPC(npc) then return end
    if npcs[npc] then return end

    local hrp = npc:FindFirstChild("HumanoidRootPart")
    local hum = npc:FindFirstChildOfClass("Humanoid")

    if not hrp or not hum then return end

    origSizes[hrp] = hrp.Size

    local _hbThrottle = 0
    local connection = RunService.Heartbeat:Connect(function(dt)
        if not npc.Parent or hum.Health <= 0 then
            cleanupNPC(npc)
            return
        end
        _hbThrottle = _hbThrottle + dt
        if _hbThrottle < 0.1 then return end
        _hbThrottle = 0
        local wanted = Vector3.new(100, 100, 100)
        if hrp.Size ~= wanted then
            hrp.Size = wanted
            hrp.Transparency = 1
            hrp.CanCollide = false
            hrp.Massless = true
        end
    end)

    npcs[npc] = {
        hrp = hrp,
        connection = connection
    }
end

