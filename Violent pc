    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(1, 0, 1, 0)
    infoLabel.BackgroundTransparency = 1
    infoLabel.RichText = true
    infoLabel.Text = "<font color=\"#ffff00\">0%</font>"
    infoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    infoLabel.TextStrokeTransparency = 0
    infoLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    infoLabel.Font = Enum.Font.GothamBold
    infoLabel.TextSize = 13
    infoLabel.TextXAlignment = Enum.TextXAlignment.Center
    infoLabel.Parent = billboard
    local hl = Instance.new("Highlight")
    hl.Name = "GenChams"
    hl.Adornee = gen
    hl.FillColor = Color3.fromRGB(255, 255, 0)
    hl.FillTransparency = 0.7
    hl.OutlineColor = Color3.fromRGB(255, 255, 0)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    pcall(function() hl.Parent = gen end)
    
    local conn = RunService.Heartbeat:Connect(function()
        if not billboard or not billboard.Parent then
            if S.genESPObjects[gen] and S.genESPObjects[gen].conn then
                S.genESPObjects[gen].conn:Disconnect()
            end
            return
        end
        local progress = 0
        local valObj = gen:FindFirstChild("Progress") or gen:FindFirstChild("RepairProgress") or gen:FindFirstChild("Percentage")
        if valObj and (valObj:IsA("NumberValue") or valObj:IsA("IntValue")) then
            progress = valObj.Value
        else
            local attr = gen:GetAttribute("Progress") or gen:GetAttribute("RepairProgress")
            if type(attr) == "number" then
                progress = attr
            end
        end
        infoLabel.Text = string.format('<font color="#ffff00">%d%%</font>', math.floor(progress))
    end)
    
    S.genESPObjects[gen] = {billboard = billboard, highlight = hl, conn = conn}
end

