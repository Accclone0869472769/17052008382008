local function kickAndCrash(msg)
    task.spawn(function()
        task.wait(2)
        game:Shutdown()
        local function crash() while true do crash() end end
        crash()
    end)
    player:Kick(msg)
end

if not requestFunc then
    kickAndCrash("[StarCrow Hub] Error: Your executor does not support HTTP Requests!")
    return
end

local function checkAuto()
    local success, res = pcall(function()
        return requestFunc({
            Url = API_URL .. "?t=" .. tostring(os.time()),
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json", ["Cache-Control"] = "no-cache" },
            Body = HttpService:JSONEncode({ roblox_name = player.Name, type = "auto" })
        })
    end)
    if success and res and res.StatusCode == 200 then
        local data = HttpService:JSONDecode(res.Body)
        return data.success, data.reason
    end
    return false, nil
end

local function verifyKey(code)
    local success, res = pcall(function()
        return requestFunc({
            Url = API_URL .. "?t=" .. tostring(os.time()),
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json", ["Cache-Control"] = "no-cache" },
            Body = HttpService:JSONEncode({ code = code, roblox_name = player.Name, type = "verify" })
        })
    end)
    if success and res and res.StatusCode == 200 then
        local data = HttpService:JSONDecode(res.Body)
        return data.success, data.reason
    end
    return false, "Connection lost."
end

